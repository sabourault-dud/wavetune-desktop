{
  "name": "wavetune-desktop",
  "productName": "Wave Tune",
  "version": "2.0.2",
  "description": "Wave Tune Desktop — Lecteur + Sync iPhone",
  "author": "Wave Tune",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.wavetune.desktop",
    "productName": "Wave Tune",
    "publish": {
    "provider": "github",
    "owner": "sabourault-dud",
    "repo": "wavetune-desktop"
  },
    "files": [
      "src/**/*",
      "!src/bin/**/*",
      "*.html"
    ],
    "extraResources": [
      {
        "from": "src/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "dmg": {
      "title": "Wave Tune",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "axios": "^1.15.2",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.5"
  }
}
